package require Tk

# ---------------------------------------------------------------------------
# Visual Tcl Environment & Project Information
# ---------------------------------------------------------------------------
set vTcl(timestamp) ""
app-path
set vTcl(actual_gui_bg) #0f131c
set vTcl(actual_gui_fg) #dfe2ee
set vTcl(actual_gui_analog) #1c2028
set vTcl(actual_gui_menu_analog) #1c2028
set vTcl(actual_gui_menu_bg) #0f131c
set vTcl(actual_gui_menu_fg) #dfe2ee
set vTcl(complement_color) #2563eb
set vTcl(analog_color_p) #181c24
set vTcl(analog_color_m) #1c2028
set vTcl(active_fg) #dfe2ee
set vTcl(actual_gui_menu_active_bg) #262a33
set vTcl(active_menu_fg) #dfe2ee
set vTcl(pr,autoalias) 1
set vTcl(pr,relative_placement) 1
set vTcl(mode) Relative

# ---------------------------------------------------------------------------
# Helper procedure: Define widget alias if supported by vTcl environment
# ---------------------------------------------------------------------------
if {[info procs ::vTcl:DefineAlias] eq ""} {
    proc ::vTcl:DefineAlias {target alias class parent {inside 0}} {}
}

# ---------------------------------------------------------------------------
# Main Window: Login / Registration / Vault Dashboard Container
# ---------------------------------------------------------------------------
proc vTclWindow.top_main {base} {
    if {$base == ""} {
        set base .top_main
    }
    if {[winfo exists $base]} {
        wm deiconify $base
        return
    }
    toplevel $base -class Toplevel -background $::vTcl(actual_gui_bg)
    wm focusmodel $base passive
    wm geometry $base 900x560+250+150
    wm maxsize $base 1920 1080
    wm minsize $base 480 480
    wm resizable $base 1 1
    wm title $base "Onesium — The Credential Vault"
    vTcl:DefineAlias "$base" "ToplevelMain" vTcl:Toplevel:WidgetProc "" 1

    # Main Container
    ttk::frame $base.container -padding {20 20 20 20}
    pack $base.container -fill both -expand 1
    vTcl:DefineAlias "$base.container" "FrameContainer" vTcl:WidgetProc "ToplevelMain" 1

    # =======================================================================
    # View 1: Login Screen Representation
    # =======================================================================
    ttk::frame $base.container.frm_login
    vTcl:DefineAlias "$base.container.frm_login" "FrameLogin" vTcl:WidgetProc "ToplevelMain" 1

    ttk::label $base.container.frm_login.lbl_title \
        -text "Password Manager Pro" -font {-family Helvetica -size 16 -weight bold}
    vTcl:DefineAlias "$base.container.frm_login.lbl_title" "LabelAppTitle" vTcl:WidgetProc "ToplevelMain" 1

    ttk::label $base.container.frm_login.lbl_sub \
        -text "Secure Multi-User Vault" -font {-family Helvetica -size 10}
    vTcl:DefineAlias "$base.container.frm_login.lbl_sub" "LabelSubtitle" vTcl:WidgetProc "ToplevelMain" 1

    ttk::label $base.container.frm_login.lbl_user -text "Username:"
    vTcl:DefineAlias "$base.container.frm_login.lbl_user" "LabelUsername" vTcl:WidgetProc "ToplevelMain" 1

    ttk::entry $base.container.frm_login.ent_user -width 35
    vTcl:DefineAlias "$base.container.frm_login.ent_user" "EntryUsername" vTcl:WidgetProc "ToplevelMain" 1

    ttk::label $base.container.frm_login.lbl_pass -text "Master Password:"
    vTcl:DefineAlias "$base.container.frm_login.lbl_pass" "LabelMasterPassword" vTcl:WidgetProc "ToplevelMain" 1

    ttk::entry $base.container.frm_login.ent_pass -show "*" -width 35
    vTcl:DefineAlias "$base.container.frm_login.ent_pass" "EntryMasterPassword" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_login.btn_login -text "Login"
    vTcl:DefineAlias "$base.container.frm_login.btn_login" "ButtonLogin" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_login.btn_to_reg -text "Register here"
    vTcl:DefineAlias "$base.container.frm_login.btn_to_reg" "ButtonToRegister" vTcl:WidgetProc "ToplevelMain" 1

    # =======================================================================
    # View 2: Registration Screen Representation
    # =======================================================================
    ttk::frame $base.container.frm_reg
    vTcl:DefineAlias "$base.container.frm_reg" "FrameRegister" vTcl:WidgetProc "ToplevelMain" 1

    ttk::label $base.container.frm_reg.lbl_title \
        -text "Create New Account" -font {-family Helvetica -size 16 -weight bold}
    vTcl:DefineAlias "$base.container.frm_reg.lbl_title" "LabelRegTitle" vTcl:WidgetProc "ToplevelMain" 1

    ttk::label $base.container.frm_reg.lbl_user -text "Username:"
    ttk::entry $base.container.frm_reg.ent_user -width 35
    vTcl:DefineAlias "$base.container.frm_reg.ent_user" "EntryRegUsername" vTcl:WidgetProc "ToplevelMain" 1

    ttk::label $base.container.frm_reg.lbl_pass -text "Master Password:"
    ttk::entry $base.container.frm_reg.ent_pass -show "*" -width 35
    vTcl:DefineAlias "$base.container.frm_reg.ent_pass" "EntryRegPassword" vTcl:WidgetProc "ToplevelMain" 1

    ttk::label $base.container.frm_reg.lbl_conf -text "Confirm Master Password:"
    ttk::entry $base.container.frm_reg.ent_conf -show "*" -width 35
    vTcl:DefineAlias "$base.container.frm_reg.ent_conf" "EntryRegConfirm" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_reg.btn_reg -text "Register"
    vTcl:DefineAlias "$base.container.frm_reg.btn_reg" "ButtonRegisterSubmit" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_reg.btn_to_login -text "Back to Login"
    vTcl:DefineAlias "$base.container.frm_reg.btn_to_login" "ButtonBackToLogin" vTcl:WidgetProc "ToplevelMain" 1

    # =======================================================================
    # View 3: Vault Dashboard Representation
    # =======================================================================
    ttk::frame $base.container.frm_dash
    vTcl:DefineAlias "$base.container.frm_dash" "FrameDashboard" vTcl:WidgetProc "ToplevelMain" 1

    # Header Bar
    ttk::frame $base.container.frm_dash.header
    ttk::label $base.container.frm_dash.header.user_info \
        -text "Logged in as: User" -font {-family Helvetica -size 12 -weight bold}
    vTcl:DefineAlias "$base.container.frm_dash.header.user_info" "LabelUserInfo" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_dash.header.btn_logout -text "Logout"
    vTcl:DefineAlias "$base.container.frm_dash.header.btn_logout" "ButtonLogout" vTcl:WidgetProc "ToplevelMain" 1

    # Search Bar
    ttk::frame $base.container.frm_dash.search
    ttk::label $base.container.frm_dash.search.lbl -text "Search Vault:"
    ttk::entry $base.container.frm_dash.search.ent -width 40
    vTcl:DefineAlias "$base.container.frm_dash.search.ent" "EntrySearch" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_dash.search.btn_clear -text "Clear"
    vTcl:DefineAlias "$base.container.frm_dash.search.btn_clear" "ButtonClearSearch" vTcl:WidgetProc "ToplevelMain" 1

    # Credential Table
    ttk::frame $base.container.frm_dash.table_frame
    ttk::treeview $base.container.frm_dash.table_frame.tree \
        -columns {site_name username_field updated_at} -show headings -selectmode browse
    vTcl:DefineAlias "$base.container.frm_dash.table_frame.tree" "TreeviewCredentials" vTcl:WidgetProc "ToplevelMain" 1

    ttk::scrollbar $base.container.frm_dash.table_frame.scroll -orient vertical
    vTcl:DefineAlias "$base.container.frm_dash.table_frame.scroll" "ScrollbarTree" vTcl:WidgetProc "ToplevelMain" 1

    # Action Toolbar
    ttk::frame $base.container.frm_dash.actions
    ttk::button $base.container.frm_dash.actions.btn_add -text "Add New"
    vTcl:DefineAlias "$base.container.frm_dash.actions.btn_add" "ButtonAddNew" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_dash.actions.btn_edit -text "Edit"
    vTcl:DefineAlias "$base.container.frm_dash.actions.btn_edit" "ButtonEdit" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_dash.actions.btn_delete -text "Delete"
    vTcl:DefineAlias "$base.container.frm_dash.actions.btn_delete" "ButtonDelete" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_dash.actions.btn_show -text "Show Password"
    vTcl:DefineAlias "$base.container.frm_dash.actions.btn_show" "ButtonShowPassword" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_dash.actions.btn_copy -text "Copy Password"
    vTcl:DefineAlias "$base.container.frm_dash.actions.btn_copy" "ButtonCopyPassword" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_dash.actions.btn_backup -text "Backup"
    vTcl:DefineAlias "$base.container.frm_dash.actions.btn_backup" "ButtonBackup" vTcl:WidgetProc "ToplevelMain" 1

    ttk::button $base.container.frm_dash.actions.btn_restore -text "Restore"
    vTcl:DefineAlias "$base.container.frm_dash.actions.btn_restore" "ButtonRestore" vTcl:WidgetProc "ToplevelMain" 1
}

# ---------------------------------------------------------------------------
# Initial Window Instantiation
# ---------------------------------------------------------------------------
if {[info exists ::argv0] && $::argv0 eq [info script]} {
    vTclWindow.top_main ""
}
